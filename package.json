{
    "name": "kopert.github.io",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "check": "eslint . && tsc --noEmit && prettier . --check",
        "fix": "eslint . --fix && prettier . --w",
        "dev": "vite",
        "build": "npm run check && vite build"
    },
    "devDependencies": {
        "@types/node": "^25.5.2",
        "eslint": "^10.2.0",
        "eslint-config-prettier": "^10.1.8",
        "jiti": "^2.6.1",
        "prettier": "^3.8.1",
        "tsx": "^4.21.0",
        "typescript-eslint": "^8.58.0",
        "vite": "^7.3.1",
        "vite-plugin-html-minifier": "^1.0.5",
        "vite-plugin-singlefile": "^2.3.2",
        "yaml": "^2.8.3"
    }
}
